pipeline {

    agent any

    tools {

        nodejs 'NodeJS'
    }

    stages {

        stage('Clone Repository') {

            steps {

                git branch: 'main',

                url: 'https://github.com/anushaxoriant/TSPlaywrightFramework.git'
            }
        }

        stage('Install Dependencies') {

            steps {

                bat 'npm install'
            }
        }

        stage('Install Browsers') {

            steps {

                bat 'npx playwright install'
            }
        }

        stage('Compile TypeScript') {

            steps {

                bat 'npx tsc --noEmit'
            }
        }

        stage('Run Tests') {

            steps {

                bat 'npx playwright test'
            }
        }
    }

post {

    always {

        archiveArtifacts(
            artifacts: 'playwright-report/**',
            allowEmptyArchive: true
        );
    }
}